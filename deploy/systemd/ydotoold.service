[Unit]
Description=ydotool daemon (uinput input injection)
After=graphical-session.target

[Service]
Type=simple
# Pin the socket to the runtime dir (NOT /tmp, which gets cleaned and silently
# breaks injection). %t expands to /run/user/<uid>.
ExecStart=/usr/bin/ydotoold -p %t/.ydotool_socket
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target